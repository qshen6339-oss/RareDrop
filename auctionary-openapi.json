{"openapi":"3.0.0","info":{"version":"1.0.0","title":"Auctionary API","description":"The Auctionary API for the 26/27 Full Stack Web Development Assignment. For help on getting started, refer to the assignment breif, teaching material, or contact Xia.","contact":{"name":"Xia","email":"x.cui@mmu.ac.uk"}},"paths":{"/users":{"post":{"tags":["User Management"],"summary":"Create an account for a new user","description":"Given that the requestBody passes validation checks, and that there is not already an account associated with the email address, an account will be created for the new user.","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddUser"}}}},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddUserResponse"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Server Error"}}}},"/login":{"post":{"tags":["User Management"],"summary":"Log into a users account","description":"Will log a user into their account given a valid email and password.","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginUser"}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Server Error"}}}},"/logout":{"post":{"tags":["User Management"],"summary":"Log out of a users account","description":"Will log a user out their account.","security":[{"User":[]}],"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorised"},"500":{"description":"Server Error"}}}},"/users/{user_id}":{"get":{"tags":["User Management"],"summary":"Get a users profile information","description":"Will return a list of information relevant to a given user.","parameters":[{"$ref":"#/components/parameters/user_id"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserDetails"}}}},"404":{"description":"Not Found"},"500":{"description":"Server Error"}}}},"/search":{"get":{"tags":["Core Auction Functionality"],"summary":"Search for an item","description":"NOTE: Leave this end point until last - it is the most difficult.\n\nSearch the list of items. \n\nQuery parameters can be used to filter the search:\n\nq: a string to search for the name of the item\nstatus:\n  BID - filter items that you have bid on\n  OPEN - filter items that you have created and that are still active\n  ARCHIVE - filter items that you have created but where bidding has now closed\nlimit: limit the number of results for pagination\noffset: used to scroll through pages of results\n","parameters":[{"$ref":"#/components/parameters/q"},{"$ref":"#/components/parameters/status"},{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/offset"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ItemList"}}}},"400":{"description":"Bad Request"},"500":{"description":"Server Error"}}}},"/item":{"post":{"tags":["Core Auction Functionality"],"summary":"Create a new item","description":"Creates a new item. Bidding close must be in the future.","security":[{"User":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddItem"}}}},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddItemResponse"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorised"},"500":{"description":"Server Error"}}}},"/item/{item_id}":{"get":{"tags":["Core Auction Functionality"],"summary":"Get a single items details","description":"Retrieves the details of a single item at a given ID.","parameters":[{"$ref":"#/components/parameters/item_id"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ItemDetails"}}}},"404":{"description":"Not Found"},"500":{"description":"Server Error"}}}},"/item/{item_id}/bid":{"post":{"tags":["Core Auction Functionality"],"summary":"Bid on an item","description":"Add a bid to an item currently being auctioned.","parameters":[{"$ref":"#/components/parameters/item_id"}],"security":[{"User":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddBid"}}}},"responses":{"201":{"description":"Bid Recieved"},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorised"},"403":{"description":"You cannot bid as the seller on this item"},"404":{"description":"Not Found"},"500":{"description":"Server Error"}}},"get":{"tags":["Core Auction Functionality"],"summary":"Get bid history","description":"See the list of bids on a specific item.","parameters":[{"$ref":"#/components/parameters/item_id"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BidHistory"}}}},"404":{"description":"Not Found"},"500":{"description":"Server Error"}}}},"/item/{item_id}/question":{"get":{"tags":["Question Management"],"summary":"Get questions","description":"View all of the questions that have been asked on a speific item.","parameters":[{"$ref":"#/components/parameters/item_id"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionList"}}}},"404":{"description":"Not Found"},"500":{"description":"Server Error"}}},"post":{"tags":["Question Management"],"summary":"Ask a question about an item","description":"Ask a question about a specific item given the items ID.","parameters":[{"$ref":"#/components/parameters/item_id"}],"security":[{"User":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddQuestion"}}}},"responses":{"200":{"description":"OK"},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorised"},"403":{"description":"You cannot ask a question on your own item"},"404":{"description":"Not Found"},"500":{"description":"Server Error"}}}},"/question/{question_id}":{"post":{"tags":["Question Management"],"summary":"Answer a question","description":"Allows the seller to answer a question at a given ID.","parameters":[{"$ref":"#/components/parameters/question_id"}],"security":[{"User":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuestionAnswer"}}}},"responses":{"200":{"description":"OK"},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorised"},"403":{"description":"Only the seller can answer questions on their items"},"404":{"description":"Not Found"},"500":{"description":"Server Error"}}}}},"components":{"parameters":{"user_id":{"name":"user_id","in":"path","description":"A unique integer ID for indentifying a User","required":true,"schema":{"type":"integer"}},"item_id":{"name":"item_id","in":"path","description":"A unique integer ID for indentifying an Item","required":true,"schema":{"type":"integer"}},"question_id":{"name":"question_id","in":"path","description":"A unique integer ID for indentifying a question","required":true,"schema":{"type":"integer"}},"q":{"name":"q","in":"query","description":"A string used to filter the search end point (i.e., to find specific item)","required":false,"schema":{"type":"string"}},"status":{"name":"status","in":"query","description":"A string used to filter the search end point (i.e., to find specific items). Must be one of BID, OPEN, ARCHIVE","required":false,"schema":{"type":"string"}},"limit":{"name":"limit","in":"query","description":"The number of items to return","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},"offset":{"name":"offset","in":"query","description":"The number of items to skip before starting to collect the result set (e.g. for pagination)","required":false,"schema":{"type":"integer","minimum":0,"default":0}}},"schemas":{"ErrorResponse":{"type":"object","properties":{"error_message":{"type":"string","example":"Relevant error message goes in here"}}},"AddUser":{"type":"object","required":["first_name","last_name","email","password"],"properties":{"first_name":{"type":"string","example":"Xia"},"last_name":{"type":"string","example":"Cui"},"email":{"type":"string","example":"x.cui@mmu.ac.uk"},"password":{"type":"string","example":"Hello123!"}}},"AddUserResponse":{"type":"object","properties":{"user_id":{"type":"integer","example":14}}},"LoginUser":{"type":"object","required":["email","password"],"properties":{"email":{"type":"string","example":"x.cui@mmu.ac.uk"},"password":{"type":"string","example":"Hello123!"}}},"LoginResponse":{"type":"object","properties":{"user_id":{"type":"integer","example":14},"session_token":{"type":"string","example":"b5d9e7be6c97aa855f721b6e742120f2"}}},"UserDetails":{"type":"object","properties":{"user_id":{"type":"integer","example":14},"first_name":{"type":"string","example":"Xia"},"last_name":{"type":"string","example":"Cui"},"selling":{"type":"array","items":{"$ref":"#/components/schemas/Item"}},"bidding_on":{"type":"array","items":{"$ref":"#/components/schemas/Item"}},"auctions_ended":{"type":"array","items":{"$ref":"#/components/schemas/Item"}}}},"ItemList":{"type":"array","items":{"$ref":"#/components/schemas/Item"}},"Item":{"type":"object","properties":{"item_id":{"type":"integer","example":77},"name":{"type":"string","example":"Henry Hoover"},"description":{"type":"string","example":"Barely used henry hoover - freshly emptied"},"end_date":{"type":"integer","example":89983256},"creator_id":{"type":"integer","example":90},"first_name":{"type":"string","example":"Xia"},"last_name":{"type":"string","example":"Cui"}}},"AddItem":{"type":"object","properties":{"name":{"type":"string","example":"Henry Hoover"},"description":{"type":"string","example":"Barely used henry hoover - freshly emptied"},"starting_bid":{"type":"integer","example":99},"end_date":{"type":"integer","example":89983256}}},"AddItemResponse":{"type":"object","properties":{"item_id":{"type":"integer","example":39}}},"ItemDetails":{"type":"object","properties":{"item_id":{"type":"integer","example":77},"name":{"type":"string","example":"Henry Hoover"},"description":{"type":"string","example":"Barely used henry hoover - freshly emptied"},"starting_bid":{"type":"integer","example":99},"start_date":{"type":"integer","example":89983256},"end_date":{"type":"integer","example":89983256},"creator_id":{"type":"integer","example":89},"first_name":{"type":"string","example":"Xia"},"last_name":{"type":"string","example":"Cui"},"current_bid":{"type":"integer","example":500},"current_bid_holder":{"type":"object","properties":{"user_id":{"type":"integer","example":7},"first_name":{"type":"string","example":"Xia"},"last_name":{"type":"string","example":"Cui"}}}}},"BidHistory":{"type":"array","items":{"$ref":"#/components/schemas/Bid"}},"Bid":{"type":"object","required":["amount"],"properties":{"item_id":{"type":"integer","example":44},"amount":{"type":"integer","example":99983},"timestamp":{"type":"integer","example":1800114646446},"user_id":{"type":"integer","example":78},"first_name":{"type":"string","example":"Xia"},"last_name":{"type":"string","example":"Cui"}}},"AddBid":{"type":"object","required":["amount"],"properties":{"amount":{"type":"integer","example":99983}}},"QuestionList":{"type":"array","items":{"$ref":"#/components/schemas/Question"}},"Question":{"type":"object","required":["question_text"],"properties":{"question_id":{"type":"integer","example":94},"question_text":{"type":"string","example":"What is the condition of the item?"},"answer_text":{"type":"string","example":"Slightly scratched"}}},"AddQuestion":{"type":"object","required":["question_text"],"properties":{"question_text":{"type":"string","example":"What is the condition of the item?"}}},"QuestionAnswer":{"type":"object","required":["answer_text"],"properties":{"answer_text":{"type":"string","example":"What is the condition of the item?"}}}},"securitySchemes":{"User":{"type":"apiKey","name":"X-Authorization","in":"header"}}},"servers":[{"description":"SwaggerHub API Auto Mocking","url":"https://virtserver.swaggerhub.com/XCUI/Auctionary/1.0.0"},{"description":"Run on your local machine","url":"http://localhost:3333"}]}